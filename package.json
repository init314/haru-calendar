{
  "name": "haru-calendar",
  "version": "1.0.0",
  "description": "하루 — 완료하는 즐거움이 있는 캘린더",
  "author": "Haru Calendar",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.haru.calendar",
    "productName": "Haru Calendar",
    "files": [
      "electron/**/*",
      "ui/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "ui/haru.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "하루 캘린더",
      "artifactName": "Haru-Calendar-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "smol-toml": "^1.8.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
